        term.setCursorPos(2, 2)
        term.write("Downloading recovery script...")
        local file = http.get("https://raw.githubusercontent.com/DOGGYWOOF/Doggy-OS/refs/heads/v13-Standard/BootROM%20recovery%20script")
        if file then
            local content = file.readAll()
            local f = fs.open("/disk/install.lua", "w")
            f.write(content)
            f.close()
            term.setCursorPos(2, 4)
            term.write("Recovery script downloaded! Running...")
            os.sleep(2)
            -- Run the downloaded script
            shell.run("/disk/install.lua")
            os.reboot()  -- Reboot after script execution
        else
            term.setCursorPos(2, 4)
            term.write("Failed to download recovery script.")
            os.pullEvent("key")  -- Wait for any key press
            os.reboot()  -- Reboot after key press
        end
    elseif key == keys.four then
        -- Reboot System
        term.clear()
        term.setBackgroundColor(colors.blue)
        term.setCursorPos(2, 2)
        term.write("Rebooting system...")
        os.pullEvent("key")  -- Wait for any key press
        os.reboot()  -- Reboot after key press
    elseif key == keys.five then
        -- Display System Info
        term.clear()
        term.setBackgroundColor(colors.blue)
        term.setCursorPos(2, 2)
        term.write("System Information")

        -- Display the system info (dummy values here, replace with actual values)
        term.setCursorPos(2, 4)
        term.write("Doggy OS Version: **v13.0**")
        term.setCursorPos(2, 6)
        term.write("Bootloader Version: **VA11-ILLA 12.0**")
        term.setCursorPos(2, 8)
        term.write("Firmware Revision: **v1.2.3**")

        -- Wait for user to press a key
        term.setCursorPos(2, 10)
        term.write("Press any key to reboot...")
        os.pullEvent("key")  -- Wait for any key press
        os.reboot()  -- Reboot after key press
    else
        -- Invalid key press
        term.setCursorPos(2, 4)
        term.write("Invalid option. Press 1, 2, 3, 4, or 5.")
        os.pullEvent("key")  -- Wait for any key press
        os.reboot()  -- Reboot after key press
