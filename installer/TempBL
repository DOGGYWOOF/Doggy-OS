local requiredFiles = {
    "/disk/bootloader/VA11-ILLA.lua",
    "/disk/os/home.lua",
    "/disk/os/lock.lua",
    "/disk/boot/boot-animation",
}

-- Set os.pullEvent for compatibility
os.pullEvent = os.pullEventRaw

-- Utility function to draw a button and wait for a click
local function drawButton(x1, y1, x2, y2, text, color, textColor)
    term.setBackgroundColor(color or colors.lightGray)
    term.setTextColor(textColor or colors.black)
    paintutils.drawBox(x1, y1, x2, y2)
    local w = x2 - x1 + 1
    local h = y2 - y1 + 1
    local textPos = x1 + math.floor((w - #text) / 2)
    term.setCursorPos(textPos, y1 + math.floor(h / 2))
    term.write(text)
    term.setBackgroundColor(colors.blue) -- Reset background for safety
    term.setTextColor(colors.white)
end

-- Function to display the initial setup/startup choice
local function initialChoiceGUI()
    -- Set background color to blue
    term.setBackgroundColor(colors.blue)
    term.clear()
    term.setTextColor(colors.white)

    local width, height = term.getSize()
    local title = "DOGGY OS BOOTROM v1.2.3"
    term.setCursorPos(math.floor((width - #title) / 2), 2)
    term.write(title)
    
    local yStart = 6
    local buttonWidth = 30
    local buttonHeight = 3
    local x1 = math.floor((width - buttonWidth) / 2)
    local x2 = x1 + buttonWidth - 1
    
    -- Draw "Enter firmware setup" button (y = 6 to 8)
    local y1_setup = yStart
    local y2_setup = y1_setup + buttonHeight - 1
    drawButton(x1, y1_setup, x2, y2_setup, "Enter firmware setup", colors.yellow, colors.black)
    
    -- Draw "Continue system startup" button (y = 10 to 12)
    local y1_continue = yStart + 4
    local y2_continue = y1_continue + buttonHeight - 1
    drawButton(x1, y1_continue, x2, y2_continue, "Continue system startup", colors.lime, colors.black)
    
    -- Wait for mouse click
    while true do
        local event, button, x, y = os.pullEvent("mouse_click")
        if event == "mouse_click" and button == 1 then
            -- Check for "Enter firmware setup" click
            if x >= x1 and x <= x2 and y >= y1_setup and y <= y2_setup then
                return "SETUP"
            -- Check for "Continue system startup" click
            elseif x >= x1 and x <= x2 and y >= y1_continue and y <= y2_continue then
                return "STARTUP"
            end
        end
    end
end

-- Function to check if all required files exist
local function checkFiles()
    local missingFiles = {}

    for _, fileName in ipairs(requiredFiles) do
        if not fs.exists(fileName) then
            table.insert(missingFiles, "[MISSING] " .. fileName)
        end
    end

    return missingFiles
end

-- Function to check if /.firmware/ directory exists
local function checkFirmware()
    -- NOTE: Changed from "/firmware/" in the original prompt to "/.firmware/"
    -- to match the check and creation logic in the original functions.
    if not fs.exists("/.firmware/") then
        return true
    end
    return false
end

-- Function to display the error GUI for missing files (Unchanged)
local function displayErrorGUI(missingFiles)
    -- Set background color to blue
    term.setBackgroundColor(colors.blue)
    term.clear()
    term.setTextColor(colors.white) -- Ensure text is white
    
    local width, height = term.getSize() -- Get screen size
    local x1, y1, x2, y2 = 1, 1, width, height -- Use full screen for box
    if width >= 51 and height >= 17 then
        x2 = 51
        y2 = 17
    end
    
    -- Draw a border around the error window
    paintutils.drawBox(x1, y1, x2, y2)

    -- Set title for the error window
    term.setCursorPos(2, 2)
    term.write("**BOOTROM ERROR!**")

    -- Set the message for the error
    term.setCursorPos(2, 4)
    term.write("System software damaged...")

    -- List all the missing files
    local y = 6
    for _, file in ipairs(missingFiles) do
        if y < y2 - 2 then -- Only write if there's space
            term.setCursorPos(2, y)
            term.write(file)
            y = y + 1
        end
    end

    -- Display footer message
    term.setCursorPos(2, y2 - 1)
    term.write("Press any key to reboot...")
    os.pullEvent("key")  -- Wait for any key press
    os.reboot()  -- Reboot after key press
end

-- Function to display the error GUI for missing firmware (Unchanged, with cleanup)
local function displayFirmwareErrorGUI()
    -- Set background color to blue
    term.setBackgroundColor(colors.blue)
    term.clear()
    term.setTextColor(colors.white) -- Ensure text is white

    local width, height = term.getSize() -- Get screen size
    local x1, y1, x2, y2 = 1, 1, width, height -- Use full screen for box
    if width >= 51 and height >= 17 then
        x2 = 51
        y2 = 17
    end

    -- Draw a border around the error window
    paintutils.drawBox(x1, y1, x2, y2)

    -- Set title for the error window
    term.setCursorPos(2, 2)
    term.write("**BOOTROM ERROR!**")

    -- Set the message for the error
    term.setCursorPos(2, 4)
    term.write("BOOTROM data is corrupted or missing!")

    -- Additional detailed message
    local y = 6
    if y <= y2 - 1 then term.setCursorPos(2, y); term.write("The required firmware data is either corrupted or"); y = y + 1 end
    if y <= y2 - 1 then term.setCursorPos(2, y); term.write("missing from the system's ROM. This prevents the"); y = y + 1 end
    if y <= y2 - 1 then term.setCursorPos(2, y); term.write("system from booting properly. Please check the firmware"); y = y + 1 end
    if y <= y2 - 1 then term.setCursorPos(2, y); term.write("files and ensure they are intact and properly configured."); y = y + 1 end

    -- Prompt to restore firmware
    y = y + 2
    if y <= y2 - 1 then term.setCursorPos(2, y); term.write("Press **DEL** to restore firmware..."); end

    -- Wait for user input (DEL key to restore firmware)
    local event, key = os.pullEvent("key")
    if key == keys.delete then
        -- Create /.firmware/ directory and reboot the system
        fs.makeDir("/.firmware/")
        term.clear()
        term.setBackgroundColor(colors.blue)
        term.setCursorPos(2, 2)
        term.write("Firmware restored! Press any key to reboot...")
        os.pullEvent("key")  -- Wait for any key press
        os.reboot()  -- Reboot after key press
    else
        -- Display message if another key is pressed
        term.setCursorPos(2, y2 - 1) -- Use bottom for final message
        term.write("Invalid key. Press DEL to restore firmware.")
        os.pullEvent("key")  -- Wait for any key press
        os.reboot()  -- Reboot after key press
    end
end

-- Function to check if redstone signal is on the right (Unchanged)
local function isRedstoneRight()
    return redstone.getInput("right") -- Returns true if there's a redstone signal on the right
end

-- Function to show the menu with blue background (Unchanged, with cleanup)
local function displayMenu()
    -- Set background color to blue for the menu
    term.setBackgroundColor(colors.blue)
    term.clear()
    term.setTextColor(colors.white) -- Ensure text is white

    local width, height = term.getSize() -- Get screen size
    local x1, y1, x2, y2 = 1, 1, width, height -- Use full screen for box
    if width >= 51 and height >= 17 then
        x2 = 51
        y2 = 17
    end

    -- Draw the menu window
    paintutils.drawBox(x1, y1, x2, y2)
    term.setCursorPos(2, 2)
    term.write("**BOOTROM MENU**")

    -- Display the menu options
    local y = 4
    if y <= y2 - 1 then term.setCursorPos(2, y); term.write("1. Update (Download startup file)"); y = y + 1 end
    if y <= y2 - 1 then term.setCursorPos(2, y); term.write("2. Reset Firmware (Wipe /.firmware/)"); y = y + 1 end
    if y <= y2 - 1 then term.setCursorPos(2, y); term.write("3. Load Recovery Script"); y = y + 1 end
    if y <= y2 - 1 then term.setCursorPos(2, y); term.write("4. Reboot System"); y = y + 1 end
    if y <= y2 - 1 then term.setCursorPos(2, y); term.write("5. System Info"); y = y + 1 end

    -- Wait for user input to select an option
    term.setCursorPos(2, y2 - 1)
    term.write("Press **1, 2, 3, 4, or 5** to select an option.")
    
    local event, key = os.pullEvent("key")
    if key == keys.one then
        -- Update: Download the "startup" file from pastebin
        term.clear()
        term.setBackgroundColor(colors.blue)
        term.setCursorPos(2, 2)
        term.write("Updating startup file...")
        local file = http.get("https://raw.githubusercontent.com/DOGGYWOOF/Doggy-OS/refs/heads/v13-Standard/startup")
        if file then
            local content = file.readAll()
            local f = fs.open("startup", "w")
            f.write(content)
            f.close()
            term.setCursorPos(2, 4)
            term.write("Update successful! Press any key to reboot...")
            os.pullEvent("key")  -- Wait for any key press
            os.reboot()  -- Reboot after key press
        else
            term.setCursorPos(2, 4)
            term.write("Failed to download file.")
            os.pullEvent("key")  -- Wait for any key press
            os.reboot()  -- Reboot after key press
        end
    elseif key == keys.two then
        -- Reset Firmware: Wipe all data in /.firmware/
        term.clear()
        term.setBackgroundColor(colors.blue)
        term.setCursorPos(2, 2)
        term.write("Resetting firmware...")
        fs.delete("/.firmware/")
