-- Main function to execute the startup logic
local function startupLogic()
    local missing = checkFiles()

    if checkFirmware() then
        -- Display firmware missing error
        displayFirmwareErrorGUI()
    elseif isRedstoneRight() then
        -- Display menu if there's a redstone signal on the right
        displayMenu()
    elseif #missing > 0 then
        -- Display GUI for the boot error
        displayErrorGUI(missing)
        -- The displayErrorGUI function handles the reboot
    else
        -- All files exist, continue with the normal startup process
        shell.run("/disk/boot/start-check.lua")
    end
end

-- New function to wrap the entire boot process
local function bootProcess()
    -- Get the user's choice from the initial GUI
    local choice = initialChoiceGUI()

    if choice == "SETUP" then
        -- If 'Enter firmware setup' is clicked, go straight to the menu
        displayMenu()
    elseif choice == "STARTUP" then
        -- If 'Continue system startup' is clicked, run the main startup logic
        startupLogic()
    end
    -- In either case, the called functions will eventually lead to a reboot or shell.run
end

-- Run the new main function
bootProcess()
